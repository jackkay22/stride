# Copy these into Render → your self-service service → Environment. Never commit real values.
#
# Deliberately NOT the service-role key here — see README.md for why. This
# backend only ever talks to Supabase as the signed-in user, using the anon
# key plus that user's own token, so Row Level Security (schema.sql) does
# the actual isolation between users.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
