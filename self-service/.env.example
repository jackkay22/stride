# Copy these into Render → your self-service service → Environment. Never commit real values.
#
# Deliberately NOT the service-role key here — see README.md for why. This
# backend only ever talks to Supabase as the signed-in user, using the anon
# key plus that user's own token, so Row Level Security (schema.sql) does
# the actual isolation between users.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional — only needed for the per-user Strava connection. Leave these out
# and the app works exactly as before, with the Strava section hidden entirely.
#
# Strava allows only one API application per account, so these are the SAME
# Client ID and Secret the personal app uses. What has to change is that app's
# Authorization Callback Domain, which must be set to jackkay22.github.io for
# this app's connect flow to work. That doesn't affect the personal app's
# existing sync — token refresh doesn't use the callback domain. See README.md
# step 5 for the full explanation and the one caveat.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
